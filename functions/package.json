{
  "name": "functions",
  "description": "Cloud Functions do banco de questões — geração do relatório de prova em PDF no servidor (Chromium headless), evitando as inconsistências do diálogo de impressão do navegador.",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "node copy-shared.mjs",
    "build": "npm run prebuild && tsc",
    "watch": "npm run prebuild && tsc --watch"
  },
  "dependencies": {
    "@sparticuz/chromium": "131.0.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2",
    "puppeteer-core": "23.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
